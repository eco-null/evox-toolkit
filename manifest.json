{
  "schemaVersion": 1,
  "pluginId": "01508eca-7af1-4dbf-8869-226e4cec4896",
  "sdkVersion": "0.2.0",
  "name": "evoX Toolkit",
  "version": "2.0.0",
  "runtime": { "kind": "trusted-node", "entry": "runtime.mjs" },
  "hostCompatibility": { "minimumVersion": "0.2.0" },
  "permissions": [{ "name": "key.display" }],
  "settingsSchema": [],
  "actions": [
    { "id": "counter", "name": "Sayaç", "description": "evoX Toolkit: bas-elti, uzun bas ile sıfırla", "controllers": ["Keypad"], "supportedInMultiActions": false, "settingsSchema": [] },
    { "id": "weather", "name": "Hava", "description": "evoX Toolkit: wttr.in hava, sıcaklık + nem, yenileme ayarı", "controllers": ["Keypad"], "supportedInMultiActions": false,
      "settingsSchema": [
        { "key": "city", "type": "text", "label": "Şehir", "required": true },
        { "key": "interval", "type": "text", "label": "Yenileme (dk) — varsayılan 30", "default": "30" }] },
    { "id": "send-hotkey", "name": "Hotkey", "description": "evoX Toolkit: modifier dropdown + tuş alanı", "controllers": ["Keypad"], "supportedInMultiActions": false,
      "settingsSchema": [
        { "key": "mods", "type": "select", "label": "Modifier", "default": "none",
          "options": [
            { "value": "none", "label": "Modifier yok" },
            { "value": "Ctrl", "label": "Ctrl" },
            { "value": "Shift", "label": "Shift" },
            { "value": "Alt", "label": "Alt" },
            { "value": "Win", "label": "Win" },
            { "value": "Ctrl+Shift", "label": "Ctrl+Shift" },
            { "value": "Ctrl+Alt", "label": "Ctrl+Alt" },
            { "value": "Ctrl+Win", "label": "Ctrl+Win" },
            { "value": "Shift+Alt", "label": "Shift+Alt" },
            { "value": "Ctrl+Shift+Alt", "label": "Ctrl+Shift+Alt" }] },
        { "key": "key", "type": "text", "label": "Tuş (ör. D, F5, Tab)" },
        { "key": "combo", "type": "text", "label": "Kısayol elle (ör. Ctrl+Shift+D)" }] },
    { "id": "type-text", "name": "Metin Yaz", "description": "evoX Toolkit: metni yazar / yapıştırır", "controllers": ["Keypad"], "supportedInMultiActions": false,
      "settingsSchema": [
        { "key": "text", "type": "text", "label": "Metin" },
        { "key": "pasteMode", "type": "toggle", "label": "Pano + yapıştır modu", "default": true }] },
    { "id": "clipboard", "name": "Pano", "description": "evoX Toolkit: panodan kopyala/yapıştır", "controllers": ["Keypad"], "supportedInMultiActions": false,
      "settingsSchema": [
        { "key": "mode", "type": "select", "label": "Mod", "default": "copy",
          "options": [{ "value": "copy", "label": "Kopyala" }, { "value": "paste", "label": "Yapıştır" }] },
        { "key": "preview", "type": "toggle", "label": "Önizleme", "default": true }] },
    { "id": "open-url", "name": "URL Aç", "description": "evoX Toolkit: http/https adresi açar", "controllers": ["Keypad"], "supportedInMultiActions": false,
      "settingsSchema": [{ "key": "url", "type": "url", "label": "Adres", "required": true }] }
  ]
}
